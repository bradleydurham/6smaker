  }

  .type-chars {
    font-family: 'Merriweather', Georgia, serif;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    line-height: 2;
  }

  .type-chars--body {
    font-family: 'Source Sans Pro', sans-serif;
    font-weight: 400;
  }

  .colors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 3rem;
  }

  .color-swatch {
    width: 100%;
    aspect-ratio: 4/3;
  }

  .color-item {
    display: flex;
