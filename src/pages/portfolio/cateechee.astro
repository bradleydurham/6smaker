    .nav-next { border-left: none; border-top: 1px solid var(--border); text-align: left; align-items: flex-start; }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  const closeBtn = document.getElementById('lightboxClose');
  const frame = document.getElementById('lightboxFrame') as HTMLIFrameElement;
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;

  document.querySelectorAll<HTMLButtonElement>('.video-trigger[data-video]').forEach(btn => {
    btn.addEventListener('click', () => {
      lightboxImg.style.display = 'none';
      frame.style.display = '';
      frame.src = `https://www.youtube.com/embed/${btn.dataset.video}?autoplay=1`;
      lightbox?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  });

  function openImageLightbox(src: string, alt: string) {
    frame.src = '';
    frame.style.display = 'none';
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightboxImg.style.display = 'block';
    lightbox?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.remove('is-open');
    frame.src = '';
    frame.style.display = '';
    lightboxImg.src = '';
    lightboxImg.style.display = 'none';
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // Carousel — infinite loop, manual navigation
  const track = document.getElementById('carouselTrack');
  const dots = document.querySelectorAll<HTMLButtonElement>('#carouselDots .dot');
  const slideCount = dots.length;

  // Clone slides before and after for seamless looping
  const realSlides = Array.from(track?.querySelectorAll<HTMLElement>('.carousel-slide') ?? []);
  realSlides.forEach(s => track?.append(s.cloneNode(true)));
  realSlides.slice().reverse().forEach(s => track?.prepend(s.cloneNode(true)));

  let current = slideCount; // start at first real slide

  function getSlideW() {
    return track?.querySelector<HTMLElement>('.carousel-slide')?.offsetWidth ?? 0;
  }

  function getOffset(index: number) {
    const slideW = getSlideW();
    const gap = parseFloat(getComputedStyle(track!).gap) || 32;
    return index * (slideW + gap) - (window.innerWidth / 2 - slideW / 2);
  }

  function setDot(index: number) {
    const dotIndex = ((index % slideCount) + slideCount) % slideCount;
    dots.forEach((d, i) => d.classList.toggle('is-active', i === dotIndex));
  }

  function jumpTo(index: number) {
    if (!track) return;
    track.style.transition = 'none';
    track.style.transform = `translateX(${-getOffset(index)}px)`;
    track.getBoundingClientRect(); // force reflow before restoring transition
    track.style.transition = '';
    current = index;
  }

  function goTo(index: number) {
    if (!track) return;
    track.style.transform = `translateX(${-getOffset(index)}px)`;
    current = index;
    setDot(index);
  }

  track?.addEventListener('transitionend', () => {
    if (current >= slideCount * 2) jumpTo(current - slideCount);
    else if (current < slideCount) jumpTo(current + slideCount);
  });

  const next = () => goTo(current + 1);
  const prev = () => goTo(current - 1);

  dots.forEach((dot, i) => dot.addEventListener('click', () => {
    const realCurrent = ((current % slideCount) + slideCount) % slideCount;
    goTo(current + (i - realCurrent));
  }));

  // Touch/drag swipe
  let startX = 0;
  track?.addEventListener('pointerdown', (e) => { startX = e.clientX; });
  track?.addEventListener('pointerup', (e) => {
    const diff = startX - e.clientX;
    if (Math.abs(diff) > 40) diff > 0 ? next() : prev();
  });

  window.addEventListener('resize', () => jumpTo(current));
  jumpTo(current); // set initial position without animation

  // Ad Carousel — 3-visible, infinite loop, manual navigation
  const adViewport = document.getElementById('adViewport');
  const adTrack = document.getElementById('adTrack');
  const adDots = document.querySelectorAll<HTMLButtonElement>('#adDots .dot');
  const adSlideCount = adDots.length;

  const adRealSlides = Array.from(adTrack?.querySelectorAll<HTMLElement>('.ad-slide') ?? []);
  adRealSlides.forEach(s => adTrack?.append(s.cloneNode(true)));
  adRealSlides.slice().reverse().forEach(s => adTrack?.prepend(s.cloneNode(true)));

  let adCurrent = adSlideCount;

  function setAdSlideWidth() {
    if (!adViewport || !adTrack) return;
    const px = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--px')) || 64;
    const gap = parseFloat(getComputedStyle(adTrack).gap) || 32;
    const containerW = Math.min(window.innerWidth - px * 2, 1200);
    const w = (containerW - gap * 2) / 3;
    adViewport.style.setProperty('--ad-slide-w', w + 'px');
  }

  function getAdOffset(index: number) {
    const slideW = adTrack?.querySelector<HTMLElement>('.ad-slide')?.offsetWidth ?? 0;
    const gap = parseFloat(getComputedStyle(adTrack!).gap) || 32;
    const groupW = slideW * 3 + gap * 2;
    const centerOffset = (window.innerWidth - groupW) / 2;
    return index * (slideW + gap) - centerOffset;
  }

  function setAdDot(index: number) {
    const i = ((index % adSlideCount) + adSlideCount) % adSlideCount;
    adDots.forEach((d, j) => d.classList.toggle('is-active', j === i));
  }

  function adJumpTo(index: number) {
    if (!adTrack) return;
    adTrack.style.transition = 'none';
    adTrack.style.transform = `translateX(${-getAdOffset(index)}px)`;
    adTrack.getBoundingClientRect();
    adTrack.style.transition = '';
    adCurrent = index;
  }

  function adGoTo(index: number) {
    if (!adTrack) return;
    adTrack.style.transform = `translateX(${-getAdOffset(index)}px)`;
    adCurrent = index;
    setAdDot(index);
  }

  adTrack?.addEventListener('transitionend', () => {
    if (adCurrent >= adSlideCount * 2) adJumpTo(adCurrent - adSlideCount);
    else if (adCurrent < adSlideCount) adJumpTo(adCurrent + adSlideCount);
  });

  adDots.forEach((dot, i) => dot.addEventListener('click', () => {
    const realCurrent = ((adCurrent % adSlideCount) + adSlideCount) % adSlideCount;
    adGoTo(adCurrent + (i - realCurrent));
  }));

  let adStartX = 0;
  let adStartTarget: Element | null = null;

  adViewport?.addEventListener('pointerdown', (e) => {
    adStartX = e.clientX;
    adStartTarget = e.target as Element;
    (e.currentTarget as HTMLElement).setPointerCapture(e.pointerId);
  });

  adViewport?.addEventListener('pointerup', (e) => {
    const diff = adStartX - e.clientX;
    if (Math.abs(diff) > 40) {
      diff > 0 ? adGoTo(adCurrent + 1) : adGoTo(adCurrent - 1);
    } else {
      const slide = adStartTarget?.closest<HTMLElement>('.ad-slide');
      const img = slide?.querySelector('img');
      if (img) openImageLightbox(img.src, img.alt);
    }
  });

  let wheelTimer: ReturnType<typeof setTimeout>;
  adViewport?.addEventListener('wheel', (e) => {
    e.preventDefault();
    clearTimeout(wheelTimer);
    wheelTimer = setTimeout(() => {
      const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      delta > 0 ? adGoTo(adCurrent + 1) : adGoTo(adCurrent - 1);
    }, 50);
  }, { passive: false });

  window.addEventListener('resize', () => { setAdSlideWidth(); adJumpTo(adCurrent); });
  setAdSlideWidth();
  adJumpTo(adCurrent);
</script>
