---
import Layout from '../../layouts/Layout.astro';
import { CirclePlay } from '@lucide/astro';

const project = {
  num: '04',
  title: 'Smartcast Media',
  category: 'Web Design',
  tags: ['Branding', 'Web', 'Animation'],
  year: '2024',
  desc: "A comprehensive creative launch for Smartcast Media's digital display platform included website design, an animated explainer video, and a library of creative shorts positioning their product as a top-tier transaction driver and revenue generator.",
  c1: '#1a1a2e',
  c2: '#0f0f1e',
  img: '/images/smartcast-media.jpg',
};
---

<Layout title="Smartcast Media" description="6sMaker — Smartcast Media case study">

  <!-- HERO -->
  <section class="project-hero">
    <div class="hero-visual" style={project.img ? '' : `background: linear-gradient(135deg, ${project.c1}, ${project.c2})`}>
      {project.img && <img src={project.img} alt={project.title} class="hero-img" />}
      <span class="hero-num">{project.num}</span>
    </div>
    <div class="container">
      <div class="hero-meta">
        <a href="/portfolio" class="back-link">← All Work</a>
        <div class="meta-tags">
          {project.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
      <div class="hero-text">
        <span class="label">{project.category}</span>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-lead">{project.desc}</p>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section reveal">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-aside">
          <span class="label">Overview</span>
          <div class="aside-line"></div>
          <dl class="project-details">
            <div class="detail-row">
              <dt>Client</dt>
              <dd>Smartcast Media</dd>
            </div>
            <div class="detail-row">
              <dt>Services</dt>
              <dd>{project.tags.join(', ')}</dd>
            </div>
          </dl>
        </div>
        <div class="overview-body">
          <p class="overview-large">
            “People spend money when and where they feel good” – Walt Disney
          </p>
          <p>
            Smartcast Media has a product and service that people can feel good about, and so do their customers. When it came to launching their innovative digital display with content management platform and ad network opportunities, they tasked 6SMaker’s creative team with bringing it to life. Our team’s website design and development, animated video depicting the advertising opportunities, and library of creative shorts for retail and organizations make Smartcast digital toppers the ultimate transaction-drivers and revenue generators.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LOGO BEFORE / AFTER -->
  <section class="section logo-compare-section reveal">
    <div class="container">
      <span class="label">The Work</span>
    </div>
    <div class="logo-compare-wrap">
      <div class="logo-compare-side logo-compare-side--left">
        <h3 class="compare-heading">Original Logo</h3>
        <p class="compare-copy">The team at Smartcast Media had a good start to their logo.</p>
      </div>

      <div class="logo-slider" id="logoSlider">
        <img class="logo-slider__img logo-slider__after" src="/images/smartcast/smartcast-after-1.jpg" alt="Refined Smartcast Media logo" />
        <img class="logo-slider__img logo-slider__before" id="sliderBefore" src="/images/smartcast/smartcast-before.jpg" alt="Original Smartcast Media logo" />
        <div class="logo-slider__handle" id="sliderHandle">
          <span class="handle-line"></span>
          <span class="handle-btn">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M5 9H1M1 9L3.5 6.5M1 9L3.5 11.5M13 9H17M17 9L14.5 6.5M17 9L14.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="handle-line"></span>
        </div>
      </div>

      <div class="logo-compare-side logo-compare-side--right">
        <h3 class="compare-heading">Refined Logo</h3>
        <p class="compare-copy">After a few tweaks, their logo had a more modern appearance &amp; was more website friendly.</p>
      </div>
    </div>
  </section>


  <section class="section reveal">
    <div class="container">
      <div class="full-visual">
        <img src="/images/smartcast/smartcast.jpg" alt="Smartcast Media website" class="full-visual__img" />
      </div>
      <div class="full-visual-cta">
        <a href="https://smartcastmedia.com/" target="_blank" rel="noopener noreferrer" class="btn-visit">Visit the Smartcast Media Site →</a>
      </div>
    </div>
  </section>

  <!-- IMAGE / TEXT: CHARACTER ANIMATION -->
  <section class="section section--bleed-right reveal">
    <div class="split-block">
      <div class="split-block__text">
        <h2 class="split-block__heading">Character Creation &amp; Animation</h2>
        <p class="split-block__copy">By using Adobe Character Animator, we were able to create an animated spokesman for Smartcast Media. Using a combination of video editing techniques, we combined the animation with motion graphics to create a very compelling introduction video.</p>
      </div>
      <div class="split-block__image">
        <button class="video-thumb" id="videoThumb" aria-label="Play video">
          <img src="/images/smartcast/Screen-Shot-2021-09-13-at-2.54.43-PM-copy.jpg" alt="Character Creation & Animation" />
          <span class="video-thumb__play">
            <CirclePlay size={64} color="white" />
          </span>
        </button>
      </div>

  <!-- VIDEO LIGHTBOX -->
  <div class="lightbox" id="videoLightbox" aria-modal="true" role="dialog" hidden>
    <button class="lightbox__close" id="lightboxClose" aria-label="Close video">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 3L17 17M17 3L3 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
    <div class="lightbox__backdrop" id="lightboxBackdrop"></div>
    <div class="lightbox__frame">
      <iframe id="videoIframe" src="" width="1280" height="720" allow="autoplay; encrypted-media; fullscreen" allowfullscreen style="border:0"></iframe>
    </div>
  </div>
    </div>
  </section>

  <!-- BRAND COLORS -->
  <section class="section reveal">
    <div class="container">
      <span class="label">Brand Colors</span>
      <div class="color-swatches">
        <div class="color-swatch">
          <div class="swatch-block" style="background: #003581;"></div>
          <div class="swatch-info">
            <span class="swatch-name">Smartcast Blue</span>
            <span class="swatch-hex">#003581</span>
          </div>
        </div>
        <div class="color-swatch">
          <div class="swatch-block" style="background: #99DDFF;"></div>
          <div class="swatch-info">
            <span class="swatch-name">Sky</span>
            <span class="swatch-hex">#99DDFF</span>
          </div>
        </div>
        <div class="color-swatch">
          <div class="swatch-block" style="background: #3FD2C7;"></div>
          <div class="swatch-info">
            <span class="swatch-name">Aqua</span>
            <span class="swatch-hex">#3FD2C7</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TYPOGRAPHY -->
  <section class="section section--dark reveal">
    <div class="container">
      <span class="label">Typography</span>
      <div class="type-grid">
        <div class="type-item">
          <p class="type-specimen type-specimen--display">Aa</p>
          <div class="type-meta">
            <span class="type-name">Bebas Neue Pro</span>
            <span class="type-role">Headline</span>
          </div>
        </div>
        <div class="type-item">
          <p class="type-specimen type-specimen--body">Aa</p>
          <div class="type-meta">
            <span class="type-name">Source Sans Pro</span>
            <span class="type-role">Body Copy</span>
          </div>
        </div>
      </div>
    </div>
  </section>


<!-- NAV: PREV / NEXT -->
  <nav class="project-nav reveal">
    <a href="/portfolio/litter-pearls/" class="nav-item nav-prev">
      <span class="label">Previous</span>
      <span class="nav-label">← Litter Pearls</span>
    </a>
    <a href="/contact" class="nav-item nav-next">
      <span class="label">Start a Project</span>
      <span class="nav-label">Work With Us →</span>
    </a>
  </nav>

</Layout>

<style>
  .project-hero { padding-top: var(--nav-h); }

  .hero-visual {
    height: 420px;
    position: relative;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-num {
    position: absolute;
    top: 1.5rem;
    left: var(--px);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }

  .meta-tags { display: flex; gap: 0.5rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
  }

  .hero-text {
    padding: 3.5rem 0 5rem;
    max-width: 800px;
  }

  .hero-text .label { display: block; margin-bottom: 1.25rem; }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin-bottom: 1.75rem;
  }

  .project-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-muted);
    max-width: 60ch;
    line-height: 1.65;
  }

  .section {
    padding: 6rem var(--px);
    border-top: 1px solid var(--border);
  }

  .section--dark { background: var(--surface); }

  .overview-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .overview-aside {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    align-self: start;
  }

  .aside-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    margin: 1rem 0 1.5rem;
  }

  .project-details { display: flex; flex-direction: column; gap: 1.25rem; }

  .detail-row dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .detail-row dd { font-size: 0.95rem; margin: 0; }

  .overview-large {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .overview-body p:last-child {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .work-blocks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .block-visual { height: 320px; }

  .block-caption,
  .full-caption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  .full-visual {
    height: 480px;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
  }

  .full-visual__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .full-visual-cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .btn-visit {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--text);
    padding: 0.85rem 1.75rem;
    transition: background 0.2s, color 0.2s;
  }
  .btn-visit:hover {
    background: var(--text);
    color: var(--bg);
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .result-item {
    background: var(--surface);
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .result-num {
    font-family: var(--font-display);
    font-size: 3.5rem;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--accent);
  }

  .result-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
  }

  .nav-item {
    padding: 3rem var(--px);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background 0.2s;
  }
  .nav-item:hover { background: var(--surface); }

  .nav-next {
    border-left: 1px solid var(--border);
    text-align: right;
    align-items: flex-end;
  }

  .nav-label {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  /* ── Logo Before/After ── */
  .logo-compare-section { padding: 6rem var(--px); }

  .logo-compare-wrap {
    display: grid;
    grid-template-columns: 200px 1fr 200px;
    gap: 3rem;
    align-items: center;
    max-width: 1200px;
    margin: 2.5rem auto 0;
    padding: 0 var(--px);
  }

  .logo-compare-side {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .logo-compare-side--right { text-align: right; }

  .compare-heading {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .compare-copy {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Slider */
  .logo-slider {
    position: relative;
    overflow: hidden;
    user-select: none;
    background: #f5f5f5;
    border-radius: 2px;
    height: 300px;
  }

  .logo-slider__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .logo-slider__before {
    clip-path: inset(0 50% 0 0);
  }

  .logo-slider__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: ew-resize;
    z-index: 10;
    width: 44px;
  }

  .handle-line {
    flex: 1;
    width: 2px;
    background: var(--accent, #e63329);
  }

  .handle-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent, #e63329);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }

  /* ── Split block (text left, image bleeds right) ── */
  .section--bleed-right { padding-right: 0; }

  .split-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  .split-block__text {
    padding-left: max(var(--px), calc((100vw - 1200px) / 2 + var(--px)));
    padding-right: 4rem;
  }

  .split-block__heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin: 0 0 1.25rem;
  }

  .split-block__copy {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .split-block__image {
    overflow: hidden;
  }

  .split-block__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Video thumbnail ── */
  .video-thumb {
    position: relative;
    display: block;
    width: 100%;
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
    overflow: hidden;
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .video-thumb:hover img { transform: scale(1.03); }

  .video-thumb__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.3);
    transition: background 0.2s;
  }

  .video-thumb:hover .video-thumb__play { background: rgba(0,0,0,0.5); }

  .video-thumb__play svg {
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4));
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] { display: none; }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.88);
    cursor: pointer;
  }

  .lightbox__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 10;
    background: none;
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
  }

  .lightbox__close:hover { background: rgba(255,255,255,0.1); }

  .lightbox__frame {
    position: relative;
    z-index: 5;
    width: min(90vw, 1280px);
    aspect-ratio: 16/9;
  }

  .lightbox__frame iframe {
    width: 100%;
    height: 100%;
  }

  /* ── Typography ── */
  .type-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .type-item {
    background: var(--bg);
    padding: 3rem 3.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .type-specimen {
    margin: 0;
    line-height: 1;
    color: var(--text);
  }

  .type-specimen--display {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(6rem, 14vw, 11rem);
  }

  .type-specimen--body {
    font-family: 'Source Sans Pro', sans-serif;
    font-size: clamp(6rem, 14vw, 11rem);
    font-weight: 400;
  }

  .type-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  .type-name {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .type-role {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  /* ── Brand Colors ── */
  .color-swatches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .swatch-block {
    height: 180px;
  }

  .swatch-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 0 0;
  }

  .swatch-name {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .swatch-hex {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero-visual { height: 260px; }
    .overview-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .overview-aside { position: static; }
    .work-blocks { grid-template-columns: 1fr; }
    .results-grid { grid-template-columns: 1fr; }
    .project-nav { grid-template-columns: 1fr; }
    .nav-next { border-left: none; border-top: 1px solid var(--border); text-align: left; align-items: flex-start; }
    .logo-compare-wrap { grid-template-columns: 1fr; }
    .section--bleed-right { padding-right: 0; }
    .split-block { grid-template-columns: 1fr; }
    .split-block__text { padding-left: var(--px); padding-right: var(--px); padding-bottom: 2.5rem; }
    .color-swatches { grid-template-columns: 1fr; }
    .type-grid { grid-template-columns: 1fr; }
    .logo-compare-side--right { text-align: left; order: 3; }
    .logo-slider { order: 2; }
  }
</style>

<script>
  const slider = document.getElementById('logoSlider');
  const before = document.getElementById('sliderBefore');
  const handle = document.getElementById('sliderHandle');

  if (slider && before && handle) {
    const _slider = slider as HTMLElement;
    const _before = before as HTMLElement;
    const _handle = handle as HTMLElement;
    let dragging = false;

    function setPos(x: number) {
      const rect = _slider.getBoundingClientRect();
      let pct = (x - rect.left) / rect.width;
      pct = Math.min(Math.max(pct, 0.02), 0.98);
      const rightClip = (1 - pct) * 100;
      _before.style.clipPath = `inset(0 ${rightClip}% 0 0)`;
      _handle.style.left = `${pct * 100}%`;
    }

    _handle.addEventListener('mousedown', () => { dragging = true; });
    window.addEventListener('mouseup', () => { dragging = false; });
    window.addEventListener('mousemove', (e) => { if (dragging) setPos(e.clientX); });

    _handle.addEventListener('touchstart', (e) => { dragging = true; e.preventDefault(); }, { passive: false });
    window.addEventListener('touchend', () => { dragging = false; });
    window.addEventListener('touchmove', (e) => { if (dragging) setPos(e.touches[0].clientX); });
  }
</script>

<script>
  const thumb = document.getElementById('videoThumb');
  const lightbox = document.getElementById('videoLightbox');
  const iframe = document.getElementById('videoIframe') as HTMLIFrameElement | null;
  const closeBtn = document.getElementById('lightboxClose');
  const backdrop = document.getElementById('lightboxBackdrop');

  const VIDEO_SRC = 'https://www.youtube.com/embed/oVzIcWosp3w?autoplay=1';

  function openLightbox() {
    if (!lightbox || !iframe) return;
    iframe.src = VIDEO_SRC;
    lightbox.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox || !iframe) return;
    lightbox.setAttribute('hidden', '');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  thumb?.addEventListener('click', openLightbox);
  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>
