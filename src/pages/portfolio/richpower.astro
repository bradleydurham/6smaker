---
import Layout from '../../layouts/Layout.astro';

const project = {
  num: '05',
  title: 'Richpower',
  category: 'Web Design',
  tags: ['Web', 'Design', 'Development'],
  year: '2024',
  desc: "Three distinct, on-brand consumer websites were designed, developed, and launched for RICHPOWER Industries' power tool brands — with ongoing maintenance and updates managed by our team.",
  c1: '#2a1a0a',
  c2: '#1a0f05',
  img: '/images/richpower.jpg',
};
---

<Layout title="6sMaker | Website Design for Richpower, Genesis & PowerSmith" description="6sMaker designed and built three websites for Richpower — a corporate site and dedicated sales sites for their Genesis and PowerSmith power tool brands.">

  <!-- HERO -->
  <section class="project-hero">
    <div class="hero-visual" style={project.img ? '' : `background: linear-gradient(135deg, ${project.c1}, ${project.c2})`}>
      {project.img && <img src={project.img} alt={project.title} class="hero-img" />}
      <span class="hero-num">{project.num}</span>
    </div>
    <div class="container">
      <div class="hero-meta">
        <a href="/portfolio" class="back-link">← All Work</a>
        <div class="meta-tags">
          {project.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
      <div class="hero-text">
        <span class="label">{project.category}</span>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-lead">{project.desc}</p>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section reveal">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-aside">
          <span class="label">Overview</span>
          <div class="aside-line"></div>
          <dl class="project-details">
            <div class="detail-row">
              <dt>Client</dt>
              <dd>RICHPOWER Industries, Genesis Power Tools, Powersmith Products</dd>
            </div>
            <div class="detail-row">
              <dt>Services</dt>
              <dd>{project.tags.join(', ')}</dd>
            </div>
            <div class="detail-row">
              <dt>Deliverables</dt>
              <dd>Website Design, Website Development, Multiple Websites</dd>
            </div>
          </dl>
        </div>
        <div class="overview-body">
          <p class="overview-large">
            “Man is a tool-using animal. Without tools he is nothing, with tools he is all.” – Thomas Carlyle
          </p>
          <p>
            RICHPOWER Industries called on us to put our tools to work for their tools. So we mustered our web designers and programmers and produced three separate websites for Richpower’s power tool brands. We balanced their objectives, timeline, budget and distinct brand identities to meet their launch needs and continue to manage maintenance and updates for these consumer targeted websites.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK SECTIONS -->
  <div class="work-label-row">
    <div class="container">
      <span class="label">The Work</span>
    </div>
  </div>

  <section class="work-feature reveal">
    <div class="work-feature__text">
      <h2 class="work-feature__headline">Richpower Corporate Website</h2>
      <p class="work-feature__copy">The team at Richpower approached us to design & build three websites for their lineup of brands. The initial site was for their parent company. It is mainly a brochure site with links to their library of downloadable content for retail partners.</p>
      <a href="https://richpowerinc.com/" target="_blank" rel="noopener" class="work-feature__btn">View Site</a>
    </div>
    <div class="work-feature__img">
      <img src="/images/richpower/1-richpower-mockup.jpg" alt="Richpower Corporate Website" loading="lazy" />
    </div>
  </section>

  <section class="work-feature work-feature--flip reveal">
    <div class="work-feature__img">
      <img src="/images/richpower/2-Genesis-mockup.jpg" alt="Genesis Website" loading="lazy" />
    </div>
    <div class="work-feature__text">
      <h2 class="work-feature__headline">Genesis Website</h2>
      <p class="work-feature__copy">For the Genesis & Powersmith sites they were looking for a template of sorts so that both sites would look similar. After a handful of revisions, we found the layout that worked best and started building.</p>
      <a href="https://genesispowertools.com/" target="_blank" rel="noopener" class="work-feature__btn">View Site</a>
    </div>
  </section>

  <section class="work-feature reveal">
    <div class="work-feature__text">
      <h2 class="work-feature__headline">Powersmith Website</h2>
      <p class="work-feature__copy">Both the Powersmith & Genesis sites featured a searchable retail location map. This was a big undertaking for our team, but as usual we pulled it off in style!</p>
      <a href="https://powersmithproducts.com/" target="_blank" rel="noopener" class="work-feature__btn">View Site</a>
    </div>
    <div class="work-feature__img">
      <img src="/images/richpower/3-Powersmith-mockup.jpg" alt="Powersmith Website" loading="lazy" />
    </div>
  </section>


<!-- NAV: PREV / NEXT -->
  <nav class="project-nav reveal">
    <a href="/portfolio/smartcast-media/" class="nav-item nav-prev">
      <span class="label">Previous</span>
      <span class="nav-label">← Smartcast Media</span>
    </a>
    <a href="/contact" class="nav-item nav-next">
      <span class="label">Start a Project</span>
      <span class="nav-label">Work With Us →</span>
    </a>
  </nav>

</Layout>

<style>
  .project-hero { padding-top: var(--nav-h); }

  .hero-visual {
    height: 420px;
    position: relative;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-num {
    position: absolute;
    top: 1.5rem;
    left: var(--px);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }

  .meta-tags { display: flex; gap: 0.5rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
  }

  .hero-text {
    padding: 3.5rem 0 5rem;
    max-width: 800px;
  }

  .hero-text .label { display: block; margin-bottom: 1.25rem; }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin-bottom: 1.75rem;
  }

  .project-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-muted);
    max-width: 60ch;
    line-height: 1.65;
  }

  .section {
    padding: 6rem var(--px);
    border-top: 1px solid var(--border);
  }

  .section--dark { background: var(--surface); }

  .overview-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .overview-aside {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    align-self: start;
  }

  .aside-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    margin: 1rem 0 1.5rem;
  }

  .project-details { display: flex; flex-direction: column; gap: 1.25rem; }

  .detail-row dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .detail-row dd { font-size: 0.95rem; margin: 0; }

  .overview-large {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .overview-body p:last-child {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .work-label-row {
    padding: 3rem var(--px) 0;
    border-top: 1px solid var(--border);
  }

  .work-feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
    border-top: 1px solid var(--border);
  }

  .work-label-row + .work-feature {
    border-top: none;
  }

  .work-feature__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem var(--px);
    gap: 1.5rem;
  }

  .work-feature__text .label { display: block; }

  .work-feature__headline {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    letter-spacing: 0.02em;
    line-height: 1.05;
  }

  .work-feature__copy {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 46ch;
  }

  .work-feature__btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text);
    border: 1px solid var(--text);
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    align-self: flex-start;
    transition: background 0.2s, color 0.2s;
  }

  .work-feature__btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }

  .work-feature__img {
    overflow: hidden;
  }

  .work-feature__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Image on right: text first, img extends to right edge */
  .work-feature:not(.work-feature--flip) {
    padding-left: var(--px);
    padding-left: 0;
  }

  .work-feature:not(.work-feature--flip) .work-feature__text {
    padding-left: var(--px);
  }

  /* Image on left: img extends to left edge */
  .work-feature--flip .work-feature__text {
    padding-right: var(--px);
  }

.project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
  }

  .nav-item {
    padding: 3rem var(--px);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background 0.2s;
  }
  .nav-item:hover { background: var(--surface); }

  .nav-next {
    border-left: 1px solid var(--border);
    text-align: right;
    align-items: flex-end;
  }

  .nav-label {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  @media (max-width: 768px) {
    .hero-visual { height: 260px; }
    .overview-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .overview-aside { position: static; }
    .work-feature {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .work-feature--flip {
      display: flex;
      flex-direction: column-reverse;
    }
    .work-feature__img { height: 280px; }
    .work-feature__text,
    .work-feature--flip .work-feature__text {
      padding: 3rem var(--px);
    }
.project-nav { grid-template-columns: 1fr; }
    .nav-next { border-left: none; border-top: 1px solid var(--border); text-align: left; align-items: flex-start; }
  }
</style>
