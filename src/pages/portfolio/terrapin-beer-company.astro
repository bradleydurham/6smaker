---
import Layout from '../../layouts/Layout.astro';

const project = {
  num: '13',
  title: 'Terrapin Beer',
  category: 'Auto Design',
  tags: ['Print', 'Wrap'],
  year: '2022',
  desc: 'The folks at Terrapin contacted us with a super fun project, and likely one of a kind. They had acquired a beer can shaped car, and wanted it wrapped to resemble one of their beer brands.',
  c1: '#2a1a0e',
  c2: '#180f08',
  img: '/images/terrapin-beer-company.jpg',
};

const gallery = [
  '/images/terrapin/1-car-front-3-4-right-view.jpg',
  '/images/terrapin/2-car-front-3-4-view.jpg',
  '/images/terrapin/3-car-front-top-view-768x1024.jpg',
  '/images/terrapin/4-car-front-view.jpg',
  '/images/terrapin/5-car-left-side-view-2.jpg',
  '/images/terrapin/6-car-left-side-view.jpg',
  '/images/terrapin/7-car-rear-3-4-right-view.jpg',
  '/images/terrapin/8-car-rear-3-4-view.jpg',
  '/images/terrapin/9-car-rear-view.jpg',
  '/images/terrapin/10-car-right-side-view.jpg',
];
---

<Layout title="Terrapin Beer" description="6sMaker — Terrapin Beer Company case study">

  <!-- HERO -->
  <section class="project-hero">
    <div class="hero-visual" style={project.img ? '' : `background: linear-gradient(135deg, ${project.c1}, ${project.c2})`}>
      {project.img && <img src={project.img} alt={project.title} class="hero-img" />}
      <span class="hero-num">{project.num}</span>
    </div>
    <div class="container">
      <div class="hero-meta">
        <a href="/portfolio" class="back-link">← All Work</a>
        <div class="meta-tags">
          {project.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
      <div class="hero-text">
        <span class="label">{project.category}</span>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-lead">{project.desc}</p>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section reveal">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-aside">
          <span class="label">Overview</span>
          <div class="aside-line"></div>
          <dl class="project-details">
            <div class="detail-row">
              <dt>Client</dt>
              <dd>Terrapin Beer Company</dd>
            </div>
            <div class="detail-row">
              <dt>Services</dt>
              <dd>{project.tags.join(', ')}</dd>
            </div>
            <div class="detail-row">
              <dt>Deliverables</dt>
              <dd>
                <ul class="deliverables-list">
                  <li>Vinyl Wrap for beer can car</li>
                  <li>Wrap installation</li>
                  <li>Lots of fun!</li>
                </ul>
              </dd>
            </div>
          </dl>
        </div>
        <div class="overview-body">
          <p class="overview-large">
            Occasionally a project so fun comes along you can't turn it down!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section section--dark reveal">
    <div class="container">
      <span class="label">The Work</span>
      <div class="gallery-grid">
        {gallery.map((src, i) => (
          <button class="gallery-thumb" data-index={i} aria-label={`View image ${i + 1}`}>
            <img src={src} alt={`Terrapin Beer wrap — view ${i + 1}`} loading="lazy" />
            <span class="thumb-overlay">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lb-close" id="lb-close" aria-label="Close">✕</button>
    <button class="lb-prev" id="lb-prev" aria-label="Previous">←</button>
    <button class="lb-next" id="lb-next" aria-label="Next">→</button>
    <div class="lb-backdrop" id="lb-backdrop"></div>
    <div class="lb-stage">
      <img src="" alt="" id="lb-img" />
      <span class="lb-counter" id="lb-counter"></span>
    </div>
  </div>

  <script>
    const images = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-thumb'))
      .map(btn => (btn.querySelector('img') as HTMLImageElement).src);

    const lightbox  = document.getElementById('lightbox')!;
    const lbImg     = document.getElementById('lb-img') as HTMLImageElement;
    const lbCounter = document.getElementById('lb-counter')!;
    const lbClose   = document.getElementById('lb-close')!;
    const lbPrev    = document.getElementById('lb-prev')!;
    const lbNext    = document.getElementById('lb-next')!;
    const lbBdrop   = document.getElementById('lb-backdrop')!;

    let current = 0;

    function open(index: number) {
      current = index;
      show();
    }

    function show() {
      lbImg.src = images[current];
      lbCounter.textContent = `${current + 1} / ${images.length}`;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function prev() { current = (current - 1 + images.length) % images.length; show(); }
    function next() { current = (current + 1) % images.length; show(); }

    document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((btn, i) => {
      btn.addEventListener('click', () => open(i));
    });

    lbClose.addEventListener('click', close);
    lbBdrop.addEventListener('click', close);
    lbPrev.addEventListener('click', prev);
    lbNext.addEventListener('click', next);

    document.addEventListener('keydown', e => {
      if (lightbox.getAttribute('aria-hidden') === 'true') return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });
  </script>

  <!-- NAV: PREV / NEXT -->
  <nav class="project-nav reveal">
    <a href="/portfolio/neon-cat-litter/" class="nav-item nav-prev">
      <span class="label">Previous</span>
      <span class="nav-label">← Neon Cat Litter</span>
    </a>
    <a href="/contact" class="nav-item nav-next">
      <span class="label">Start a Project</span>
      <span class="nav-label">Work With Us →</span>
    </a>
  </nav>

</Layout>

<style>
  .project-hero { padding-top: var(--nav-h); }

  .hero-visual {
    height: 420px;
    position: relative;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-num {
    position: absolute;
    top: 1.5rem;
    left: var(--px);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }

  .meta-tags { display: flex; gap: 0.5rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
  }

  .hero-text {
    padding: 3.5rem 0 5rem;
    max-width: 800px;
  }

  .hero-text .label { display: block; margin-bottom: 1.25rem; }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin-bottom: 1.75rem;
  }

  .project-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-muted);
    max-width: 60ch;
    line-height: 1.65;
  }

  .section {
    padding: 6rem var(--px);
    border-top: 1px solid var(--border);
  }

  .section--dark { background: var(--surface); }

  .overview-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .overview-aside {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    align-self: start;
  }

  .aside-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    margin: 1rem 0 1.5rem;
  }

  .project-details { display: flex; flex-direction: column; gap: 1.25rem; }

  .detail-row dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .detail-row dd { font-size: 0.95rem; margin: 0; }

  .deliverables-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .deliverables-list li {
    font-size: 0.95rem;
    color: var(--text);
    padding-left: 0.75rem;
    position: relative;
  }

  .deliverables-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.7rem;
    top: 0.15em;
  }

  .overview-large {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 600;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .overview-body p:last-child {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  /* ── GALLERY ── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .gallery-thumb {
    position: relative;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: block;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }

  .gallery-thumb:hover img { transform: scale(1.05); }

  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .gallery-thumb:hover .thumb-overlay { opacity: 1; }

  /* ── LIGHTBOX ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .lightbox[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .lb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.92);
  }

  .lb-stage {
    position: relative;
    z-index: 1;
    max-width: min(90vw, 1200px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .lb-stage img {
    max-width: 100%;
    max-height: calc(90vh - 3rem);
    object-fit: contain;
    display: block;
  }

  .lb-counter {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }

  .lb-close,
  .lb-prev,
  .lb-next {
    position: fixed;
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    cursor: pointer;
    z-index: 2;
    transition: color 0.2s;
    font-family: var(--font-mono);
  }

  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover { color: #fff; }

  .lb-close {
    top: 1.5rem;
    right: 1.5rem;
    font-size: 1.25rem;
    line-height: 1;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    padding: 1rem;
  }

  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }

  @media (max-width: 768px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .result-item {
    background: var(--surface);
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .result-num {
    font-family: var(--font-display);
    font-size: 3.5rem;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--accent);
  }

  .result-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
  }

  .nav-item {
    padding: 3rem var(--px);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background 0.2s;
  }
  .nav-item:hover { background: var(--surface); }

  .nav-next {
    border-left: 1px solid var(--border);
    text-align: right;
    align-items: flex-end;
  }

  .nav-label {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  @media (max-width: 768px) {
    .hero-visual { height: 260px; }
    .overview-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .overview-aside { position: static; }
    .work-blocks { grid-template-columns: 1fr; }
    .results-grid { grid-template-columns: 1fr; }
    .project-nav { grid-template-columns: 1fr; }
    .nav-next { border-left: none; border-top: 1px solid var(--border); text-align: left; align-items: flex-start; }
  }
</style>
