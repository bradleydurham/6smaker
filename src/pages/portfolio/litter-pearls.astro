---
import Layout from '../../layouts/Layout.astro';
import { FingerprintPattern, Palette, Cat, Flame } from '@lucide/astro';

const project = {
  num: '03',
  title: 'Litter Pearls',
  category: 'Packaging Design',
  tags: ['Branding', 'Package', 'Video'],
  year: '2024',
  desc: 'A complete brand refresh for Litter Pearls delivered a modernized logo, upscale packaging, and digital marketing support — including product videos and social content for global virtual pet shows.',
  c1: '#2e1a0a',
  c2: '#1a0f05',
};
---

<Layout title="Litter Pearls" description="6sMaker — Litter Pearls brand refresh case study">

  <!-- HERO -->
  <section class="project-hero">
    <div class="hero-visual">
      <video autoplay muted loop playsinline>
        <source src="/images/litter-pearls/v4_litter_pearls.mp4" type="video/mp4" />
      </video>
      <span class="hero-num">{project.num}</span>
    </div>
    <div class="container">
      <div class="hero-meta">
        <a href="/portfolio" class="back-link">← All Work</a>
        <div class="meta-tags">
          {project.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
      <div class="hero-text">
        <span class="label">{project.category}</span>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-lead">{project.desc}</p>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section reveal">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-aside">
          <span class="label">Overview</span>
          <div class="aside-line"></div>
          <dl class="project-details">
            <div class="detail-row">
              <dt>Client</dt>
              <dd>Litter Pearls</dd>
            </div>
            <div class="detail-row">
              <dt>Services</dt>
              <dd>{project.tags.join(', ')}</dd>
            </div>
          </dl>
        </div>
        <div class="overview-body">
          <p class="overview-large">
            “The way to my heart is covered with paw prints.” – Barbara L. Diamond
          </p>
          <p>
            Litter Pearls needed new branding to reintroduce their product line that keeps cats’ paws comfortable and litter particles in the box. We modernized their visual brand language with a fresh, new logo and color palette and created an upscale packaging design that even the most discerning cat purrr-sons appreciate. To top things off, we supported their digital marketing efforts at global virtual pet shows with product videos, showroom graphics and social media content.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PLACEHOLDER CONTENT BLOCKS -->
  <section class="section section--dark reveal">
    <div class="container">
      <span class="label">The Work</span>
      <div class="work-blocks">
        <div class="work-block">
          <div class="block-visual" style={`background: linear-gradient(135deg, ${project.c1}, ${project.c2})`}></div>
          <p class="block-caption">Caption describing this piece of work or deliverable.</p>
        </div>
        <div class="work-block">
          <div class="block-visual" style={`background: linear-gradient(160deg, ${project.c2}, ${project.c1})`}></div>
          <p class="block-caption">Caption describing this piece of work or deliverable.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-COLUMN FEATURE -->
  <section class="section section--lighter reveal">
    <div class="container">
      <div class="feature-grid">

        <!-- Left column -->
        <div class="feature-col feature-col--side">
          <div class="feature-item">
            <div class="feature-icon"><FingerprintPattern size={28} /></div>
            <h3 class="feature-headline">New Logo Mark</h3>
            <p class="feature-copy">The new logo brings the brand into a contemporary new world both through form and color usage.</p>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><Palette size={28} /></div>
            <h3 class="feature-headline">New Colors</h3>
            <p class="feature-copy">To go along with the new mark, a new array of colors was introduced to help define each product in their line-up.</p>
          </div>
        </div>

        <!-- Center image -->
        <div class="feature-col feature-col--center">
          <img src="/images/litter-pearls/litter-pearls-cat.svg" alt="Litter Pearls cat illustration" class="feature-image" />
        </div>

        <!-- Right column -->
        <div class="feature-col feature-col--side">
          <div class="feature-item">
            <div class="feature-icon"><Cat size={28} /></div>
            <h3 class="feature-headline">The Star</h3>
            <p class="feature-copy">Of course we highlighted the star of the brand... cats! A silhouetted cat's head is featured as the pearl of the mark.</p>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><Flame size={28} /></div>
            <h3 class="feature-headline">Abstraction</h3>
            <p class="feature-copy">The swirl pattern was introduced as a way to give movement to a static logo. The added benefit is using an oyster shell shaped form reinforces the brand's name: Litter Pearls.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 5-COLUMN LOGOS -->
  <section class="section section--lighter reveal">
    <div class="container">
      <div class="logo-grid">
        <button class="logo-col" data-src="/images/litter-pearls/logo/LP-Crystal-Clear.svg" data-alt="LP Crystal Clear">
          <img src="/images/litter-pearls/logo/LP-Crystal-Clear.svg" alt="LP Crystal Clear" />
        </button>
        <button class="logo-col" data-src="/images/litter-pearls/logo/LP-Micro-Fresh.svg" data-alt="LP Micro Fresh">
          <img src="/images/litter-pearls/logo/LP-Micro-Fresh.svg" alt="LP Micro Fresh" />
        </button>
        <button class="logo-col" data-src="/images/litter-pearls/logo/LP-Micro.svg" data-alt="LP Micro">
          <img src="/images/litter-pearls/logo/LP-Micro.svg" alt="LP Micro" />
        </button>
        <button class="logo-col" data-src="/images/litter-pearls/logo/LP-Tracksless.svg" data-alt="LP Tracksless">
          <img src="/images/litter-pearls/logo/LP-Tracksless.svg" alt="LP Tracksless" />
        </button>
        <button class="logo-col" data-src="/images/litter-pearls/logo/LP-Ultra-Clump.svg" data-alt="LP Ultra Clump">
          <img src="/images/litter-pearls/logo/LP-Ultra-Clump.svg" alt="LP Ultra Clump" />
        </button>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="full-visual">
        <img src="/images/litter-pearls/Litter-Pearls.png" alt="Litter Pearls package design" />
      </div>
      <h2 class="full-headline">Package Design</h2>
    </div>
  </section>

  <!-- INFORMATIONAL VIDEOS -->
  <section class="section section--dark reveal">
    <div class="container">
      <span class="label">Video Production</span>
      <h2 class="videos-headline">Informational Videos</h2>
      <div class="video-row">
        <button class="video-thumb" data-video="dmqDltwXxUA" aria-label="Play video">
          <img src="https://img.youtube.com/vi/dmqDltwXxUA/maxresdefault.jpg" alt="Litter Pearls product video" />
          <span class="play-btn" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M4 3l14 7-14 7V3z" fill="currentColor"/>
            </svg>
          </span>
        </button>
        <div class="video-text">
          <h3 class="video-text-headline">There's a reason cat videos are so popular.</h3>
          <p class="video-text-copy">Cats are unpredictable! We loved having Sophia, Heathrow and Phasma in studio for product and instructional video shoots.</p>
        </div>
      </div>

      <div class="video-grid">
        <button class="video-thumb" data-video="VxhgoegFnBg" aria-label="Play video">
          <img src="https://img.youtube.com/vi/VxhgoegFnBg/hqdefault.jpg" alt="Litter Pearls video" />
          <span class="play-btn" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 3l14 7-14 7V3z" fill="currentColor"/></svg>
          </span>
        </button>
        <button class="video-thumb" data-video="f_VUc33jGd8" aria-label="Play video">
          <img src="https://img.youtube.com/vi/f_VUc33jGd8/hqdefault.jpg" alt="Litter Pearls video" />
          <span class="play-btn" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 3l14 7-14 7V3z" fill="currentColor"/></svg>
          </span>
        </button>
        <button class="video-thumb" data-video="IRM1NUK20i8" aria-label="Play video">
          <img src="https://img.youtube.com/vi/IRM1NUK20i8/hqdefault.jpg" alt="Litter Pearls video" />
          <span class="play-btn" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 3l14 7-14 7V3z" fill="currentColor"/></svg>
          </span>
        </button>
        <button class="video-thumb" data-video="DtZa2oVuhE4" aria-label="Play video">
          <img src="https://img.youtube.com/vi/DtZa2oVuhE4/hqdefault.jpg" alt="Litter Pearls video" />
          <span class="play-btn" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 3l14 7-14 7V3z" fill="currentColor"/></svg>
          </span>
        </button>
      </div>
    </div>
  </section>

  <!-- COLOR SECTIONS -->
  <section class="section reveal">
    <div class="container">
      <h2 class="colors-headline">Crystal Clear Colors</h2>
      <div class="color-grid">
        <div class="color-item">
          <div class="color-swatch" style="background: #1a5532;"></div>
          <div class="color-meta">
            <span class="color-name">Hunter</span>
            <span class="color-descriptor">Pantone 357C</span>
            <span class="color-hex">#1a5532</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #03ae4b;"></div>
          <div class="color-meta">
            <span class="color-name">Green</span>
            <span class="color-descriptor">Pantone 354C</span>
            <span class="color-hex">#03ae4b</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #84caa1;"></div>
          <div class="color-meta">
            <span class="color-name">Mint</span>
            <span class="color-descriptor">Pantone 353C</span>
            <span class="color-hex">#84caa1</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <h2 class="colors-headline">Micro Fresh Colors</h2>
      <div class="color-grid">
        <div class="color-item">
          <div class="color-swatch" style="background: #05665e;"></div>
          <div class="color-meta">
            <span class="color-name">Ocean</span>
            <span class="color-descriptor">Pantone 329C</span>
            <span class="color-hex">#05665e</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #008275;"></div>
          <div class="color-meta">
            <span class="color-name">Teal</span>
            <span class="color-descriptor">Pantone 327C</span>
            <span class="color-hex">#008275</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #07aea9;"></div>
          <div class="color-meta">
            <span class="color-name">Sapphire</span>
            <span class="color-descriptor">Pantone 326C</span>
            <span class="color-hex">#07aea9</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <h2 class="colors-headline">Micro Colors</h2>
      <div class="color-grid">
        <div class="color-item">
          <div class="color-swatch" style="background: #75246c;"></div>
          <div class="color-meta">
            <span class="color-name">Plum</span>
            <span class="color-descriptor">Pantone 255C</span>
            <span class="color-hex">#75246c</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #a6228b;"></div>
          <div class="color-meta">
            <span class="color-name">Magenta</span>
            <span class="color-descriptor">Pantone 248C</span>
            <span class="color-hex">#a6228b</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #db85b7;"></div>
          <div class="color-meta">
            <span class="color-name">Rose</span>
            <span class="color-descriptor">Pantone 673C</span>
            <span class="color-hex">#db85b7</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <h2 class="colors-headline">Tracksless Colors</h2>
      <div class="color-grid">
        <div class="color-item">
          <div class="color-swatch" style="background: #252C72;"></div>
          <div class="color-meta">
            <span class="color-name">Navy</span>
            <span class="color-descriptor">Pantone 662C</span>
            <span class="color-hex">#252C72</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #427bbf;"></div>
          <div class="color-meta">
            <span class="color-name">Blue</span>
            <span class="color-descriptor">Pantone 660C</span>
            <span class="color-hex">#427bbf</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #79a1d5;"></div>
          <div class="color-meta">
            <span class="color-name">Sky</span>
            <span class="color-descriptor">Pantone 659C</span>
            <span class="color-hex">#79a1d5</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <h2 class="colors-headline">Ultra Clump Colors</h2>
      <div class="color-grid">
        <div class="color-item">
          <div class="color-swatch" style="background: #25216d;"></div>
          <div class="color-meta">
            <span class="color-name">Eggplant</span>
            <span class="color-descriptor">Pantone 273C</span>
            <span class="color-hex">#25216d</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #572c81;"></div>
          <div class="color-meta">
            <span class="color-name">Purple</span>
            <span class="color-descriptor">Pantone 268C</span>
            <span class="color-hex">#572c81</span>
          </div>
        </div>
        <div class="color-item">
          <div class="color-swatch" style="background: #8666ac;"></div>
          <div class="color-meta">
            <span class="color-name">Orchid</span>
            <span class="color-descriptor">Pantone 265C</span>
            <span class="color-hex">#8666ac</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TYPOGRAPHY -->
  <section class="section section--dark reveal">
    <div class="container">
      <span class="label">Typography</span>
      <div class="type-grid">

        <div class="type-col">
          <p class="type-specimen" style="font-family: 'Aller', sans-serif;">Aller</p>
          <div class="type-divider"></div>
          <p class="type-role">Headline</p>
          <p class="type-alpha" style="font-family: 'Aller', sans-serif;">Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz</p>
          <div class="type-weights">
            <span style="font-family: 'Aller', sans-serif; font-weight: 300;">Light</span>
            <span style="font-family: 'Aller', sans-serif; font-weight: 400;">Regular</span>
            <span style="font-family: 'Aller', sans-serif; font-weight: 700;">Bold</span>
            <span style="font-family: 'Aller', sans-serif; font-style: italic;">Italic</span>
          </div>
          <p class="type-sample" style="font-family: 'Aller', sans-serif;">The quick brown fox jumps over the lazy dog. 0123456789</p>
        </div>

        <div class="type-col">
          <p class="type-specimen" style="font-family: 'Open Sans', sans-serif;">Open Sans</p>
          <div class="type-divider"></div>
          <p class="type-role">Body</p>
          <p class="type-alpha" style="font-family: 'Open Sans', sans-serif;">Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz</p>
          <div class="type-weights">
            <span style="font-family: 'Open Sans', sans-serif; font-weight: 300;">Light</span>
            <span style="font-family: 'Open Sans', sans-serif; font-weight: 400;">Regular</span>
            <span style="font-family: 'Open Sans', sans-serif; font-weight: 600;">SemiBold</span>
            <span style="font-family: 'Open Sans', sans-serif; font-weight: 700;">Bold</span>
            <span style="font-family: 'Open Sans', sans-serif; font-style: italic;">Italic</span>
          </div>
          <p class="type-sample" style="font-family: 'Open Sans', sans-serif;">The quick brown fox jumps over the lazy dog. 0123456789</p>
        </div>

      </div>
    </div>
  </section>

  <!-- NAV: PREV / NEXT -->
  <nav class="project-nav reveal">
    <a href="/portfolio/e-commerce-support/" class="nav-item nav-prev">
      <span class="label">Previous</span>
      <span class="nav-label">← Home Depot E-Com Support</span>
    </a>
    <a href="/contact" class="nav-item nav-next">
      <span class="label">Start a Project</span>
      <span class="nav-label">Work With Us →</span>
    </a>
  </nav>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Media viewer">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close">✕</button>
    <div class="lightbox-inner">
      <iframe id="lightboxFrame" src="" title="Video" style="border:0" allow="autoplay; fullscreen" allowfullscreen></iframe>
      <img id="lightboxImg" src="" alt="" />
    </div>
  </div>

</Layout>

<style>
  .project-hero { padding-top: var(--nav-h); }

  .hero-visual {
    height: 800px;
    position: relative;
    overflow: hidden;
  }

  .hero-visual video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-num {
    position: absolute;
    top: 1.5rem;
    left: var(--px);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }

  .meta-tags { display: flex; gap: 0.5rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
  }

  .hero-text {
    padding: 3.5rem 0 5rem;
    max-width: 800px;
  }

  .hero-text .label { display: block; margin-bottom: 1.25rem; }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin-bottom: 1.75rem;
  }

  .project-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-muted);
    max-width: 60ch;
    line-height: 1.65;
  }

  .section {
    padding: 6rem var(--px);
    border-top: 1px solid var(--border);
  }

  .section--dark { background: var(--surface); }
  .section--lighter {
    background: #f0ece6;
    color: #1a1714;
  }

  .logo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo-col {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    overflow: hidden;
    cursor: pointer;
    background: none;
    border: none;
  }

  .logo-col img {
    width: 100%;
    max-width: 160px;
    height: auto;
    display: block;
    transition: transform 0.35s ease;
  }

  .logo-col:hover img { transform: scale(1.1); }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-inner.is-image {
    background: #f0ece6;
    padding: 3rem;
  }

  #lightboxImg {
    width: min(90vw, 700px);
    height: auto;
    display: block;
  }

  .lightbox-close {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    background: none;
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    font-size: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, background 0.2s;
    z-index: 1001;
  }

  .lightbox-close:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.6); }
  .section--lighter .feature-headline { color: #1a1714; }
  .section--lighter .feature-copy { color: #5a5048; }

  .overview-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .overview-aside {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    align-self: start;
  }

  .aside-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    margin: 1rem 0 1.5rem;
  }

  .project-details { display: flex; flex-direction: column; gap: 1.25rem; }

  .detail-row dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .detail-row dd { font-size: 0.95rem; margin: 0; }

  .overview-large {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.6;
