<script>
  const lightbox = document.getElementById('lightbox');
  const closeBtn = document.getElementById('lightboxClose');
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lightboxFrame = document.getElementById('lightboxFrame') as HTMLIFrameElement;
  const lightboxInner = lightbox?.querySelector('.lightbox-inner');

  document.querySelectorAll<HTMLButtonElement>('.logo-col[data-src]').forEach(btn => {
    btn.addEventListener('click', () => {
      lightboxFrame.style.display = 'none';
      lightboxFrame.src = '';
      lightboxImg.src = btn.dataset.src!;
      lightboxImg.alt = btn.dataset.alt ?? '';
      lightboxImg.style.display = 'block';
      lightboxInner?.classList.add('is-image');
      lightbox?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.video-thumb[data-video]').forEach(btn => {
    btn.addEventListener('click', () => {
      lightboxImg.style.display = 'none';
      lightboxImg.src = '';
      lightboxInner?.classList.remove('is-image');
      lightboxFrame.src = `https://www.youtube.com/embed/${btn.dataset.video}?autoplay=1`;
      lightboxFrame.style.display = 'block';
      lightbox?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLightbox() {
    lightbox?.classList.remove('is-open');
    lightboxImg.src = '';
    lightboxImg.style.display = '';
    lightboxFrame.src = '';
    lightboxFrame.style.display = 'none';
    lightboxInner?.classList.remove('is-image');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>
