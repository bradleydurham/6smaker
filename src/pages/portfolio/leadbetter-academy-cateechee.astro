---
import Layout from '../../layouts/Layout.astro';

const project = {
  num: '07',
  title: 'The Leadbetter Academy at Cateechee',
  category: 'Video Production',
  tags: ['Video', 'Motion'],
  year: '2023',
  desc: 'If you want to learn the dance of the golf swing, we know just the instructor. Jeff, the director of instruction at The Leadbetter Academy, brought us out to create an instructional video series. We had a great time not only producing these step-by-step videos, but also learning how to improve our swings.',
  c1: '#2e1f14',
  c2: '#1a120b',
};
---

<Layout title="6sMaker | Instructional Video & Digital Ads for Leadbetter Academy" description="6sMaker produced a series of golf instructional videos and digital advertising assets for The Leadbetter Academy at Cateechee, helping promote their coaching programs online.">

  <!-- HERO -->
  <section class="project-hero">
    <div class="hero-visual" style="background-image: url('/images/Leadbetter-Header.jpg'); background-size: cover; background-position: center;">
      <span class="hero-num">{project.num}</span>
    </div>
    <div class="container">
      <div class="hero-meta">
        <a href="/portfolio" class="back-link">← All Work</a>
        <div class="meta-tags">
          {project.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
      <div class="hero-text">
        <span class="label">{project.category}</span>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-lead">{project.desc}</p>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section reveal">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-aside">
          <span class="label">Overview</span>
          <div class="aside-line"></div>
          <dl class="project-details">
            <div class="detail-row">
              <dt>Client</dt>
              <dd>The Leadbetter Academy at Cateechee</dd>
            </div>
            <div class="detail-row">
              <dt>Services</dt>
              <dd>{project.tags.join(', ')}</dd>
            </div>
          </dl>
        </div>
        <div class="overview-body">
          <p class="overview-large">
            “The golf swing is very, very rhythmic. There’s a certain tempo to it, just like in music.” – Justin Timberlake
          </p>
          <p>
            If you want to learn the intricate dance of the golf swing — all its moving parts, its rhythm, its carefully sequenced mechanics — we know just the instructor to guide you through it. Jeff, the director of instruction at The Leadbetter Academy, invited us out to bring his teaching to life through a comprehensive instructional video series. With decades of expertise and a gift for breaking down complex technique into clear, digestible steps, Jeff made for the perfect on-camera guide. We had an incredible time not only producing these beautifully shot, step-by-step videos, but also soaking in the instruction ourselves along the way. Somewhere between setting up lights and adjusting camera angles, we found ourselves genuinely improving our own swings — a bonus we didn't see coming. The result is a series we're proud of: informative, approachable, and built for golfers at every level who are ready to take their game to the next level.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE WORK -->
  <section class="section section--dark reveal">
    <div class="container">
      <span class="label">The Work</span>
      <div class="work-video-wrap">
        <video src="/images/Leadbetter.mp4" autoplay muted loop playsinline aria-hidden="true"></video>
      </div>
      <div class="work-text">
        <h2 class="work-headline">Change It Up to Keep It Interesting</h2>
        <p class="work-copy">Three ways we can enhance the watchability of your tutorial.</p>
      </div>
    </div>
  </section>

  <!-- THREE TECHNIQUES -->
  <section class="section reveal">
    <div class="container">
      <div class="techniques-grid">
        <div class="technique">
          <button class="technique-video" data-video="ps2Z1YvbE5s" aria-label="Play Change Perspective">
            <img src="https://img.youtube.com/vi/ps2Z1YvbE5s/maxresdefault.jpg" alt="Change Perspective" loading="lazy" />
            <span class="play-btn" aria-hidden="true"></span>
          </button>
          <div class="technique-text">
            <h3 class="technique-headline">Change Perspective <span class="duration">2:37</span></h3>
            <p class="technique-copy">Jump cuts and other types of transitions between camera positions can change point of view & add interest.</p>
          </div>
        </div>
        <div class="technique">
          <button class="technique-video" data-video="XVDNMrLQx78" aria-label="Play Motion Graphics">
            <img src="https://img.youtube.com/vi/XVDNMrLQx78/maxresdefault.jpg" alt="Motion Graphics" loading="lazy" />
            <span class="play-btn" aria-hidden="true"></span>
          </button>
          <div class="technique-text">
            <h3 class="technique-headline">Motion Graphics <span class="duration">1:45</span></h3>
            <p class="technique-copy">Sometimes a picture is worth a thousand words. Motion graphics can make your point more clear.</p>
          </div>
        </div>
        <div class="technique">
          <button class="technique-video" data-video="teTwAHlMpDs" aria-label="Play Close-ups">
            <img src="https://img.youtube.com/vi/teTwAHlMpDs/maxresdefault.jpg" alt="Close-ups" loading="lazy" />
            <span class="play-btn" aria-hidden="true"></span>
          </button>
          <div class="technique-text">
            <h3 class="technique-headline">Close-ups <span class="duration">2:03</span></h3>
            <p class="technique-copy">As with motion graphics, a close up view to give the viewer a better understanding of what you are talking about can be invaluable.</p>
          </div>
        </div>
      </div>
      <div class="playlist-wrap">
        <a href="https://www.youtube.com/playlist?list=PLg_WOJ70kKXnS_dXKphR_yc4ZsaxZAKZY" target="_blank" rel="noopener noreferrer" class="playlist-btn">View Full Playlist</a>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" aria-modal="true" role="dialog" aria-label="Video player">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close video">&#x2715;</button>
    <div class="lightbox-inner">
      <div class="lightbox-video">
        <iframe id="lightbox-iframe" src="" title="Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </div>

  <!-- NAV: PREV / NEXT -->
  <nav class="project-nav reveal">
    <a href="/portfolio/cateechee/" class="nav-item nav-prev">
      <span class="label">Previous</span>
      <span class="nav-label">← Cateechee</span>
    </a>
    <a href="/contact" class="nav-item nav-next">
      <span class="label">Start a Project</span>
      <span class="nav-label">Work With Us →</span>
    </a>
  </nav>

</Layout>

<style>
  .project-hero { padding-top: var(--nav-h); }

  .hero-visual {
    height: 420px;
    position: relative;
  }

  .hero-num {
    position: absolute;
    top: 1.5rem;
    left: var(--px);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }

  .meta-tags { display: flex; gap: 0.5rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.2rem 0.6rem;
  }

  .hero-text {
    padding: 3.5rem 0 5rem;
    max-width: 800px;
  }

  .hero-text .label { display: block; margin-bottom: 1.25rem; }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin-bottom: 1.75rem;
  }

  .project-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-muted);
    max-width: 60ch;
    line-height: 1.65;
  }

  .section {
    padding: 6rem var(--px);
    border-top: 1px solid var(--border);
  }

  .section--dark { background: var(--surface); }

  .overview-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .overview-aside {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    align-self: start;
  }

  .aside-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    margin: 1rem 0 1.5rem;
  }

  .project-details { display: flex; flex-direction: column; gap: 1.25rem; }

  .detail-row dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .detail-row dd { font-size: 0.95rem; margin: 0; }

  .overview-large {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .overview-body p:last-child {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .work-video-wrap {
    margin-top: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .work-video-wrap video {
    width: 100%;
    display: block;
  }

  .work-text {
    max-width: 1200px;
    margin: 2.5rem auto 0;
    text-align: center;
  }

  .work-headline {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .work-copy {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .techniques-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .technique-video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
    width: 100%;
    padding: 0;
    cursor: pointer;
    border: none;
    display: block;
  }

  .technique-video img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .technique-video:hover img { transform: scale(1.04); }

  .play-btn {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    border: 2px solid rgba(255,255,255,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
    pointer-events: none;
  }

  .play-btn::after {
    content: '';
    display: block;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 9px 0 9px 18px;
    border-color: transparent transparent transparent #fff;
    margin-left: 4px;
  }

  .technique-video:hover .play-btn {
    background: rgba(0,0,0,0.8);
    transform: scale(1.1);
  }

  /* LIGHTBOX */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0,0,0,0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.6);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0.5rem;
    line-height: 1;
    transition: color 0.2s;
  }

  .lightbox-close:hover { color: #fff; }

  .lightbox-inner {
    width: min(90vw, 1100px);
  }

  .lightbox-video {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .lightbox-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .technique-text {
    padding-top: 1.25rem;
  }

  .technique-headline {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    letter-spacing: 0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.6em;
  }

  .duration {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.15);
    font-weight: 400;
  }

  .technique-copy {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .playlist-wrap {
    text-align: center;
    margin-top: 3rem;
  }

  .playlist-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text);
    border: 1px solid var(--text-muted);
    padding: 0.85rem 2rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .playlist-btn:hover {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  @media (max-width: 900px) {
    .techniques-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  .block-caption,
  .full-caption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  .full-visual {
    height: 480px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .full-caption { text-align: center; }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .result-item {
    background: var(--surface);
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .result-num {
    font-family: var(--font-display);
    font-size: 3.5rem;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--accent);
  }

  .result-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
  }

  .nav-item {
    padding: 3rem var(--px);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background 0.2s;
  }
  .nav-item:hover { background: var(--surface); }

  .nav-next {
    border-left: 1px solid var(--border);
    text-align: right;
    align-items: flex-end;
  }

  .nav-label {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  @media (max-width: 768px) {
    .hero-visual { height: 260px; }
    .overview-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .overview-aside { position: static; }
    .work-blocks { grid-template-columns: 1fr; }
    .results-grid { grid-template-columns: 1fr; }
    .project-nav { grid-template-columns: 1fr; }
    .nav-next { border-left: none; border-top: 1px solid var(--border); text-align: left; align-items: flex-start; }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const iframe = document.getElementById('lightbox-iframe') as HTMLIFrameElement;
  const closeBtn = document.getElementById('lightbox-close')!;

  function openLightbox(videoId: string) {
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.technique-video[data-video]').forEach(btn => {
    btn.addEventListener('click', () => openLightbox(btn.dataset.video!));
  });

  closeBtn.addEventListener('click', closeLightbox);

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
