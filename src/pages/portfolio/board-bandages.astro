---
import Layout from '../../layouts/Layout.astro';

const project = {
  num: '11',
  title: 'Board Bandages',
  category: 'Product Development',
  tags: ['Print', 'Web', 'Package'],
  year: '2022',
  desc: 'Board Bandages is a pioneering surf product that lets surfers quickly seal board damage on the spot and get back in the water within minutes.',
  c1: '#162a16',
  c2: '#0d190d',
};
---

<Layout title="6sMaker | Branding & Packaging for Board Bandages" description="From product development to packaging design, 6sMaker helped Board Bandages build a cohesive brand identity for their surf board repair kit line.">

  <!-- HERO -->
  <section class="project-hero">
    <div class="hero-visual">
      <img src="/images/board-bandages.jpg" alt="Board Bandages" class="hero-img" />
      <span class="hero-num">{project.num}</span>
    </div>
    <div class="container">
      <div class="hero-meta">
        <a href="/portfolio" class="back-link">← All Work</a>
        <div class="meta-tags">
          {project.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
      <div class="hero-text">
        <span class="label">{project.category}</span>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-lead">{project.desc}</p>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="section reveal">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-aside">
          <span class="label">Overview</span>
          <div class="aside-line"></div>
          <dl class="project-details">
            <div class="detail-row">
              <dt>Client</dt>
              <dd>Board Bandages</dd>
            </div>
            <div class="detail-row">
              <dt>Services</dt>
              <dd>{project.tags.join(', ')}</dd>
            </div>
            <div class="detail-row">
              <dt>Deliverables</dt>
              <dd>Logo Development, Branding, Product Development, Packaging Design, Website Development</dd>
            </div>
          </dl>
        </div>
        <div class="overview-body">
          <p class="overview-large">
            “The best surfer out there is the one having the most fun.” – Phil Edwards
          </p>
          <p>
            Brad at Board Bandages helps surfers have fun or continue having fun by getting them back in the water quickly after damaging their surfboard. Brad pioneered a product that seals damaged surfboards on the spot. With a simple wipe and apply, a surfer can be back in the water within minutes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE WORK -->
  <section class="section section--dark reveal">
    <div class="container">
      <span class="label">The Work</span>
      <h2 class="work-headline">Package Design</h2>
      <div class="gallery-four">
        <button class="gallery-item" data-lightbox="0"><img src="/images/board-bandages/package-gallery/01-Board-Bandages-product-mockup-front-longboard.jpg" alt="Board Bandages package mockup front longboard" /></button>
        <button class="gallery-item" data-lightbox="1"><img src="/images/board-bandages/package-gallery/02-board-bandages-5218.jpg" alt="Board Bandages packaging" /></button>
        <button class="gallery-item" data-lightbox="2"><img src="/images/board-bandages/package-gallery/03-Board-Bandages-product-mockup.jpg" alt="Board Bandages product mockup" /></button>
        <button class="gallery-item" data-lightbox="3"><img src="/images/board-bandages/package-gallery/04-DSC_8975.jpg" alt="Board Bandages product photo" /></button>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div id="lightbox" aria-modal="true" role="dialog" aria-label="Image viewer">
    <button id="lb-close" aria-label="Close">&#x2715;</button>
    <button id="lb-prev" aria-label="Previous">&#x2190;</button>
    <button id="lb-next" aria-label="Next">&#x2192;</button>
    <div id="lb-img-wrap">
      <img id="lb-img" src="" alt="" />
    </div>
  </div>

  <!-- FEATURES -->
  <section class="section reveal">
    <div class="container">
      <div class="features-grid">

        <!-- Left column -->
        <div class="features-col features-col--left">
          <div class="feature-item">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            </div>
            <h3 class="feature-headline">Product Development</h3>
            <p class="feature-text">We brainstormed material solutions to Brad's initial product idea. Together with Brad, we came up with a winning solution.</p>
          </div>
          <div class="feature-item">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"/><path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z"/></svg>
            </div>
            <h3 class="feature-headline">Easy Customization</h3>
            <p class="feature-text">Brad's customers can easily design their own Board Bandages to sell at their store.</p>
          </div>
        </div>

        <!-- Center column -->
        <div class="features-col features-col--center">
          <img src="/images/board-bandages/board-bandage-1.gif" alt="Board Bandages product in action" class="features-gif" />
        </div>

        <!-- Right column -->
        <div class="features-col features-col--right">
          <div class="feature-item">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3 class="feature-headline">Worldwide Availability</h3>
            <p class="feature-text">Once the product was designed and tested, we built Brad a custom, world-class, eCommerce website.</p>
          </div>
          <div class="feature-item">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/><path d="M3.477 10.896a4 4 0 0 1 .585-.396"/><path d="M19.938 10.5a4 4 0 0 1 .585.396"/><path d="M6 18a4 4 0 0 1-1.967-.516"/><path d="M19.967 17.484A4 4 0 0 1 18 18"/></svg>
            </div>
            <h3 class="feature-headline">Proprietary Material</h3>
            <p class="feature-text">Using our patented printing and material combination, we helped Brad develop his product.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- LOGO DEVELOPMENT -->
  <section class="logo-section reveal">
    <div class="logo-section-bg" style="background-image: url('/images/board-bandages/AdobeStock_220164473.jpeg')"></div>
    <div class="container logo-section-inner">
      <div class="logo-text">
        <span class="label">Logo Development</span>
        <h2 class="logo-headline">Polishing a<br />Great Start</h2>
        <p class="logo-body">Taking Brad's initial logo concept, we worked closely with him to refine the logo into something any brand could be proud of displaying worldwide.</p>
      </div>
      <div class="logo-image-wrap">
        <img src="/images/board-bandages/BoardBandages-Logo.jpg" alt="Board Bandages logo" class="logo-image" />
      </div>
    </div>
  </section>

  <!-- NAV: PREV / NEXT -->
  <nav class="project-nav reveal">
    <a href="/portfolio/the-iron-yard/" class="nav-item nav-prev">
      <span class="label">Previous</span>
      <span class="nav-label">← The Iron Yard</span>
    </a>
    <a href="/contact" class="nav-item nav-next">
      <span class="label">Start a Project</span>
      <span class="nav-label">Work With Us →</span>
    </a>
  </nav>

</Layout>

<script>
  const images = [
    { src: '/images/board-bandages/package-gallery/01-Board-Bandages-product-mockup-front-longboard.jpg', alt: 'Board Bandages package mockup front longboard' },
    { src: '/images/board-bandages/package-gallery/02-board-bandages-5218.jpg', alt: 'Board Bandages packaging' },
    { src: '/images/board-bandages/package-gallery/03-Board-Bandages-product-mockup.jpg', alt: 'Board Bandages product mockup' },
    { src: '/images/board-bandages/package-gallery/04-DSC_8975.jpg', alt: 'Board Bandages product photo' },
  ];

  let current = 0;

  const lb = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;

  function open(index: number) {
    current = index;
    lbImg.src = images[current].src;
    lbImg.alt = images[current].alt;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lb.classList.remove('open');
    document.body.style.overflow = '';
  }

  function prev() { open((current - 1 + images.length) % images.length); }
  function next() { open((current + 1) % images.length); }

  document.querySelectorAll('[data-lightbox]').forEach(btn => {
    btn.addEventListener('click', () => open(Number((btn as HTMLElement).dataset.lightbox)));
  });

  document.getElementById('lb-close')!.addEventListener('click', close);
  document.getElementById('lb-prev')!.addEventListener('click', prev);
  document.getElementById('lb-next')!.addEventListener('click', next);

  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
  });
</script>

<style>
  .project-hero { padding-top: var(--nav-h); }

  .hero-visual {
    height: 420px;
    position: relative;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-num {
    position: absolute;
    top: 1.5rem;
    left: var(--px);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
