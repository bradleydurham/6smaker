    letter-spacing: 0.04em;
    color: var(--text);
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  .features-col {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .features-col--center {
    align-items: center;
    justify-content: center;
  }

  .features-gif {
    width: 100%;
    height: auto;
    display: block;
    background: #fff;
    padding: 2rem;
  }

  .feature-item { display: flex; flex-direction: column; gap: 0.75rem; }

  .feature-icon { color: var(--accent); }

  .feature-headline {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    line-height: 1.1;
  }

  .feature-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .logo-section {
    position: relative;
    border-top: 1px solid var(--border);
    overflow: hidden;
    min-height: 500px;
    display: flex;
    align-items: center;
  }

  .logo-section-bg {
    position: absolute;
