    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  #lb-close,
  #lb-prev,
  #lb-next {
    position: fixed;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    font-size: 1.5rem;
    padding: 1rem;
    transition: color 0.2s;
    line-height: 1;
  }

  #lb-close,
  #lb-prev,
  #lb-next:hover { color: #fff; }

  #lb-close { top: 1.5rem; right: 1.5rem; font-size: 1.25rem; }
  #lb-prev { left: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 2rem; }
  #lb-next { right: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 2rem; }

  .block-caption,
