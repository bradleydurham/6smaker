  }

  .logo-section-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .logo-text { display: flex; flex-direction: column; gap: 1.5rem; }

  .logo-text .label { display: block; }

  .logo-headline {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: 0.02em;
    line-height: 0.95;
  }

  .logo-body {
    font-size: 1.05rem;
    color: var(--text-muted);
