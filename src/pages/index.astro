---
import Layout from '../layouts/Layout.astro';

const tickerItems = ['Web Design', 'Brand Identity', 'Digital Strategy', 'Product Design', 'Development', 'Motion Design'];
const tickerFull = Array(6).fill(tickerItems).flat();
---

<Layout title="Home" description="6sMaker — Design-first studio building digital products that matter">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-left">
        <span class="label hero-label">Est. 2024</span>
        <h1 class="hero-heading">We<br/>Build<br/>Things<br/>That<br/>Matter.</h1>
      </div>
      <div class="hero-right">
        <p class="hero-desc">
          A design-first studio crafting digital products, brand identities,
          and web experiences that move people and grow businesses.
        </p>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-num">50+</span>
            <span class="stat-label">Projects</span>
          </div>
          <div class="stat">
            <span class="stat-num">30+</span>
            <span class="stat-label">Clients</span>
          </div>
          <div class="stat">
            <span class="stat-num">100%</span>
            <span class="stat-label">Craft</span>
          </div>
        </div>
        <div class="hero-ctas">
          <a href="/portfolio" class="btn btn-primary">View Our Work</a>
          <a href="/contact" class="btn btn-ghost">Let's Talk →</a>
        </div>
      </div>
    </div>
    <div class="hero-scroll">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {tickerFull.flatMap(s => [
        <span>{s}</span>, <span class="ticker-dot">◆</span>
      ])}
    </div>
  </div>

  <!-- WORK PREVIEW -->
  <section class="work-preview">
    <div class="container">
      <div class="section-hd reveal">
        <span class="label">Selected Work</span>
        <a href="/portfolio" class="view-all">View All →</a>
      </div>
      <div class="projects-grid">
        <article class="project-card reveal">
          <div class="card-num">01</div>
          <div class="card-visual" style="--c1: #1a3a2a; --c2: #0d1f16;"></div>
          <div class="card-body">
            <span class="label">Brand Identity</span>
            <h3>Meridian Studio</h3>
            <p>Complete visual identity for an architecture firm redefining urban spaces.</p>
            <a href="/portfolio" class="card-link">View Project →</a>
          </div>
        </article>
        <article class="project-card reveal" style="--delay: 0.1s">
          <div class="card-num">02</div>
          <div class="card-visual" style="--c1: #0f2233; --c2: #071422;"></div>
          <div class="card-body">
            <span class="label">Product Design</span>
            <h3>Pulse Health</h3>
            <p>Intuitive health tracking app designed around human behavior and real habits.</p>
            <a href="/portfolio" class="card-link">View Project →</a>
          </div>
        </article>
        <article class="project-card reveal" style="--delay: 0.2s">
          <div class="card-num">03</div>
          <div class="card-visual" style="--c1: #2e1a0a; --c2: #1a0f05;"></div>
          <div class="card-body">
            <span class="label">Web Design</span>
            <h3>Terroir</h3>
            <p>Editorial web experience for an award-winning restaurant group.</p>
            <a href="/portfolio" class="card-link">View Project →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="teaser">
    <div class="container">
      <div class="teaser-inner reveal">
        <div class="teaser-quote">
          <blockquote>
            "Good design is not about how it looks.<br/>
            It's about how well it works — and how<br/>
            much it <em>matters</em> to the people who use it."
          </blockquote>
        </div>
        <div class="teaser-body">
          <p>
            We're a small, focused studio that believes craft matters. We work with founders,
            brands, and teams who want to build things that last — not just things that ship.
          </p>
          <a href="/about" class="btn btn-outline">Our Story →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="cta-banner reveal">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-heading">Ready to build<br/><em>something great?</em></h2>
        <a href="/contact" class="btn btn-primary">Start a Project</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── HERO ── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--nav-h) var(--px) 5rem;
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
      radial-gradient(ellipse 60% 50% at 70% 40%, rgba(232,39,42,0.05) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 20% 70%, rgba(232,39,42,0.03) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: flex-end;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-label {
    display: block;
    margin-bottom: 1.5rem;
    animation: fadeUp 0.6s ease both;
  }

  .hero-heading {
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 11rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    animation: fadeUp 0.7s 0.08s ease both;
  }

  .hero-right {
    padding-bottom: 0.5rem;
    animation: fadeUp 0.7s 0.18s ease both;
  }

  .hero-desc {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-muted);
    max-width: 38ch;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .hero-stats {
    display: flex;
    gap: 3rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    right: var(--px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    animation: fadeUp 0.6s 0.4s ease both;
  }

  .hero-scroll span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    writing-mode: vertical-rl;
  }

  .scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--text-muted), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  /* ── TICKER ── */
  .ticker {
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    padding: 1.1rem 0;
    background: var(--surface);
  }

  .ticker-track {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: max-content;
    animation: ticker 60s linear infinite;
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .ticker-dot { color: var(--accent); font-size: 0.6rem; }

  /* ── WORK PREVIEW ── */
  .work-preview {
    padding: 7rem var(--px);
  }

  .section-hd {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .view-all {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .view-all:hover { color: var(--text); }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .project-card {
    background: var(--surface);
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease;
  }
  .project-card:hover { transform: translateY(-4px); }

  .card-num {
    position: absolute;
    top: 1rem;
    left: 1.25rem;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    z-index: 1;
  }

  .card-visual {
    height: 220px;
    background: linear-gradient(135deg, var(--c1), var(--c2));
    transition: height 0.4s ease;
  }
  .project-card:hover .card-visual { height: 240px; }

  .card-body {
    padding: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .card-body .label { margin-bottom: 0.5rem; display: block; }
  .card-body h3 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: 0.04em;
    margin-bottom: 0.6rem;
    line-height: 1;
  }
  .card-body p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .card-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .project-card:hover .card-link { opacity: 1; }

  /* ── ABOUT TEASER ── */
  .teaser {
    padding: 7rem var(--px);
    border-top: 1px solid var(--border);
  }

  .teaser-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .teaser-quote blockquote {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--text);
    position: relative;
    padding-left: 2rem;
    border-left: 2px solid var(--accent);
  }

  .teaser-body p {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  /* ── CTA BANNER ── */
  .cta-banner {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 7rem var(--px);
  }

  .cta-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
  }
  .cta-heading em {
    font-style: italic;
    font-family: var(--font-body);
    font-weight: 300;
    color: var(--text-muted);
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50%       { opacity: 1; transform: scaleY(1.15); }
  }

  /* ── MOBILE ── */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 3rem; }
    .projects-grid { grid-template-columns: 1fr; }
    .teaser-inner { grid-template-columns: 1fr; gap: 3rem; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
    .hero-scroll { display: none; }
  }
</style>
